<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <!-- O SDK usa o Newtonsoft internamente, sem expor seus tipos (ADR 0010). O adaptador Unity
         mantém o pacote oficial com.unity.nuget.newtonsoft-json e sua validação no Marco 5. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <!-- O restore dos testes de integração recusa os transitivos criptográficos 10.0.12 vulneráveis.
         DataProtection 10.0.14 exige Xml >= 10.0.14, que exige Pkcs >= 10.0.14.
         O pinning fica habilitado só no Api.Tests, sem mudar o grafo distribuído pelo SDK. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <!-- MIT; o Deque.AxeCore.Commons transitivo embute o axe-core (MPL-2.0), aceitável porque fica só no
         projeto de teste e nunca é distribuído. Roda o axe-core no Playwright com resultado tipado. -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <PackageVersion Include="Yaml2JsonNode" Version="3.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
