@*
    O formulário "New flag" do rascunho: chave, tipo, rollout e, numa flag JSON, os dois valores. Monta o pedido, manda
    para a API e avisa quem o usa quando a flag nasce (design spec, 2.1).
*@
@inherits ConsolePage
@inject ConsoleApi Api

<section class="mt-10" aria-labelledby="new-flag">
    <h2 id="new-flag" class="text-lg font-semibold">New flag</h2>
    <form class="mt-4 space-y-4" @onsubmit="CreateFlagAsync" @onsubmit:preventDefault>
        <div class="max-w-lg space-y-4">
            <div>
                <label for="flag-key" class="block text-sm font-medium text-slate-700">Key</label>
                <input id="flag-key" @ref="_key" required maxlength="64" @bind="_newFlag.Key" @bind:after="() => ClearFieldError(FieldErrors.Key)"
                       aria-invalid="@(KeyError is null ? null : "true")" aria-describedby="@(KeyError is null ? null : "flag-key-error")"
                       class="tf-field w-full font-mono" />
                <FieldError Id="flag-key-error" Message="@KeyError" />
            </div>
            <fieldset aria-describedby="type-hint">
                <legend class="text-sm font-medium text-slate-700">Type</legend>
                <p id="type-hint" class="text-xs text-slate-500">Chosen now and fixed for good: games read the flag with this type.</p>
                <div class="mt-2 grid grid-cols-2 gap-3">
                    <label class="@CardStyle(FlagTypes.Boolean) flex cursor-pointer gap-3 rounded-md border px-4 py-3 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-indigo-600">
                        <input type="radio" name="flag-type" id="flag-type-boolean" value="@FlagTypes.Boolean"
                               checked="@(!_newFlag.IsJson)" @onchange="() => ChooseType(FlagTypes.Boolean)"
                               class="mt-1 h-4 w-4 focus-visible:outline-none" />
                        <span>
                            <span class="block text-sm font-medium text-slate-800">Boolean</span>
                            <span class="block text-xs text-slate-500">On or off: <code>true</code> or <code>false</code>.</span>
                        </span>
                    </label>
                    <label class="@CardStyle(FlagTypes.Json) flex cursor-pointer gap-3 rounded-md border px-4 py-3 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-indigo-600">
                        <input type="radio" name="flag-type" id="flag-type-json" value="@FlagTypes.Json"
                               checked="@_newFlag.IsJson" @onchange="() => ChooseType(FlagTypes.Json)"
                               class="mt-1 h-4 w-4 focus-visible:outline-none" />
                        <span>
                            <span class="block text-sm font-medium text-slate-800">JSON</span>
                            <span class="block text-xs text-slate-500">A number, text, list or object the game parses.</span>
                        </span>
                    </label>
                </div>
            </fieldset>
            <div>
                <label for="rollout" class="block text-sm font-medium text-slate-700">Rollout (%)</label>
                <input id="rollout" @ref="_rollout" type="number" required min="0" max="100" step="0.01" @bind="_newFlag.RolloutPercent"
                       aria-invalid="@(RolloutError is null ? null : "true")" aria-describedby="@(RolloutError is null ? null : "rollout-error")"
                       class="tf-field w-40" />
                <FieldError Id="rollout-error" Message="@RolloutError" />
            </div>
            <label class="flex items-center gap-2">
                <input type="checkbox" @bind="_newFlag.Enabled" class="h-4 w-4" />
                <span class="text-sm text-slate-700">Enabled</span>
            </label>
        </div>
        @if (_newFlag.IsJson)
        {
            <div class="max-w-4xl pt-4">
                <JsonValuesInput @ref="_values"
                                 @bind-OnValueText="_newFlag.OnValueText" @bind-OnValueText:after="() => ClearFieldError(FieldErrors.OnValue)"
                                 @bind-OffValueText="_newFlag.OffValueText" @bind-OffValueText:after="() => ClearFieldError(FieldErrors.OffValue)"
                                 RolloutPercent="_newFlag.RolloutPercent" Enabled="_newFlag.Enabled" Errors="_fieldErrors" TooLarge="_valuesTooLarge" />
            </div>
        }
        <div class="max-w-lg">
            <ProblemMessage Problem="_problem" Heading="@ProblemHeading" />
        </div>
        <button type="submit" disabled="@_submitting"
                class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-60">
            Add to draft
        </button>
    </form>
</section>

@code {
    private NewFlag _newFlag = new();
    private Problem? _problem;
    private FieldErrors _fieldErrors = new();
    private bool _valuesTooLarge;
    private bool _submitting;
    private ElementReference _key;
    private ElementReference _rollout;
    private JsonValuesInput? _values;

    /// <summary>O ambiente cujo rascunho recebe a flag.</summary>
    [Parameter, EditorRequired]
    public EnvironmentAddress Address { get; set; } = new(Guid.Empty, string.Empty, string.Empty);

    /// <summary>A flag entrou no rascunho; quem mostra o rascunho o relê.</summary>
    [Parameter]
    public EventCallback Created { get; set; }

    private string? KeyError => _fieldErrors.For(FieldErrors.Key);

    private string? RolloutError => _fieldErrors.For(FieldErrors.Rollout);

    private string? ProblemHeading => _problem == FormProblems.OutOfJsonRoom ? FormProblems.OutOfJsonRoom.Title : null;

    private async Task CreateFlagAsync()
    {
        (_problem, _fieldErrors, _valuesTooLarge) = (null, new FieldErrors(), false);
        if (!_newFlag.TryGetCreation(out var creation, out var errors))
        {
            await MarkFieldsAsync(errors);
            return;
        }

        _submitting = true;
        var flag = await Api.CreateFlagAsync(Address.OrganizationId, Address.ProjectKey, Address.EnvironmentKey, creation, Leaving);
        _submitting = false;
        if (flag.Succeeded)
        {
            _newFlag = new NewFlag();
            await Created.InvokeAsync();
            return;
        }

        await ExplainAsync(flag.Problem);
    }

    /// <summary>
    /// Nada foi gravado, e o formulário fica como o membro o deixou, para ele corrigir. Erro de campo vai para o
    /// campo; corpo grande demais, para os valores, que são o que cresce; o teto JSON do rascunho ganha o texto do
    /// console; o resto (chave já usada no rascunho, <c>key-taken</c>, e o teto de 200 flags) vai para a mensagem geral
    /// com o texto da API.
    /// </summary>
    /// <remarks>O mesmo switch do <c>FlagEditor.ExplainAsync</c>, sem o 412 e o 404; fica repetido até uma terceira tela.</remarks>
    private async Task ExplainAsync(Problem problem)
    {
        switch (problem.StatusCode)
        {
            case System.Net.HttpStatusCode.BadRequest:
                var (fields, general) = FieldErrors.Split(problem);
                await MarkFieldsAsync(fields, general);
                break;
            case System.Net.HttpStatusCode.Conflict when problem.Type == FormProblems.JsonBudgetReachedType:
                _problem = FormProblems.OutOfJsonRoom;
                break;
            case System.Net.HttpStatusCode.RequestEntityTooLarge when _newFlag.IsJson:
                _valuesTooLarge = true;
                break;
            default:
                _problem = problem;
                break;
        }
    }

    // Cada erro fica sob o seu campo, o resumo avisa o leitor de tela (role="alert"), e o foco vai para o primeiro
    // campo a corrigir, na ordem da página (design spec, 2.2 e 3).
    private async Task MarkFieldsAsync(FieldErrors fields, Problem? general = null)
    {
        _fieldErrors = fields;
        _problem = general ?? (fields.IsEmpty ? null : FormProblems.FixMarkedFields);
        if (fields.For(FieldErrors.Key) is not null)
        {
            await _key.FocusAsync();
        }
        else if (fields.For(FieldErrors.Rollout) is not null)
        {
            await _rollout.FocusAsync();
        }
        else if (_values is not null && (fields.For(FieldErrors.OnValue) ?? fields.For(FieldErrors.OffValue)) is not null)
        {
            await _values.FocusAsync(fields.For(FieldErrors.OnValue) is null ? FieldErrors.OffValue : FieldErrors.OnValue);
        }
    }

    // O resumo fala dos campos marcados; quando o último deixa de estar, ele já não diz respeito ao formulário.
    private void ClearFieldError(string field)
    {
        _fieldErrors.Clear(field);
        if (_fieldErrors.IsEmpty && _problem == FormProblems.FixMarkedFields)
        {
            _problem = null;
        }
    }

    // Os textos JSON ficam guardados na troca: voltar para JSON antes de enviar devolve o que o membro digitou.
    private void ChooseType(string type) => _newFlag.Type = type;

    // O rádio marcado é o sinal principal; a cor do cartão é reforço (design spec, 2.1).
    private string CardStyle(string type) =>
        _newFlag.Type == type ? "border-indigo-500 bg-indigo-50/60 ring-1 ring-indigo-500" : "border-slate-500 bg-white";
}
