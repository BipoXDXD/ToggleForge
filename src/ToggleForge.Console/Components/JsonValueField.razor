@*
    Uma área de valor JSON: título, para quem vai, o texto, o medidor de bytes e o erro de sintaxe ao digitar. O texto
    é sempre valor do textarea ou conteúdo de <pre>, codificado pelo Blazor (canvas, T6); o Tab continua movendo o
    foco, sem armadilha de teclado.
*@
@{
    var analysis = JsonText.Analyze(Text);
    var showsSyntax = analysis is JsonAnalysis.Invalid or JsonAnalysis.TooDeep;
    var error = showsSyntax ? null : Error;
    var invalid = showsSyntax || error is not null || analysis is JsonAnalysis.Valid { Level: MeterLevel.OverLimit };
}
<div>
    <div class="flex items-baseline justify-between gap-3">
        <label for="@Id" class="text-sm font-medium text-slate-700">@Label</label>
        <div class="flex gap-3">
            @Actions
            <button type="button" data-testid="@($"{Id}-format")" disabled="@(analysis is not JsonAnalysis.Valid)" @onclick="FormatAsync"
                    class="text-xs font-medium text-indigo-700 hover:underline disabled:cursor-not-allowed disabled:text-slate-400 disabled:no-underline">
                Format
            </button>
        </div>
    </div>
    <p id="@($"{Id}-audience")" class="text-xs text-slate-500">@Audience</p>
    <textarea @ref="_area" id="@Id" rows="8" wrap="off" spellcheck="false" autocomplete="off" autocapitalize="off"
              placeholder="@Placeholder" value="@Text" @oninput="ChangeAsync"
              aria-invalid="@(invalid ? "true" : null)" aria-describedby="@DescribedBy(showsSyntax, error is not null)"
              class="@(invalid ? "border-red-500 focus:ring-red-600" : "border-slate-500 focus:border-indigo-500 focus:ring-indigo-500") mt-2 block w-full resize-y rounded-md border bg-white px-3 py-2 font-mono text-[13px] leading-5 text-slate-800 focus:outline-none focus:ring-1"></textarea>

    @switch (analysis)
    {
        case JsonAnalysis.Valid valid:
            <div id="@($"{Id}-size")" class="mt-2">
                <div aria-hidden="true" class="h-1 rounded-full bg-slate-200">
                    <div class="@MeterStyle(valid.Level).Bar h-1 rounded-full" style="width: @MeterWidth(valid.ByteCount)"></div>
                </div>
                <p class="@MeterStyle(valid.Level).Text mt-1 flex justify-between gap-3 text-xs tabular-nums">
                    @switch (valid.Level)
                    {
                        case MeterLevel.NearLimit:
                            <span><span aria-hidden="true">⚠</span> Near the limit</span>
                            break;
                        case MeterLevel.OverLimit:
                            <span><span aria-hidden="true">⚠</span> Over the limit by @Bytes(valid.BytesOverLimit)</span>
                            break;
                    }
                    <span class="ml-auto">@Thousands(valid.ByteCount) of @Thousands(JsonText.MaxValueBytes) bytes</span>
                </p>
            </div>
            break;
        case JsonAnalysis.Empty:
            <p id="@($"{Id}-size")" class="mt-2 text-xs text-slate-500">
                Any JSON value: <code>3</code>, <code>"gold"</code>, <code>[1, 2]</code> or an object.
            </p>
            break;
        default:
            <p id="@($"{Id}-size")" class="mt-2 text-xs text-slate-500">Size appears once the JSON is valid.</p>
            break;
    }

    @* Só o nível muda aqui, não a contagem: o leitor de tela fala na troca de estado, não a cada tecla. *@
    <p id="@($"{Id}-live")" aria-live="polite" class="sr-only">@LiveText(analysis)</p>

    @if (showsSyntax)
    {
        <div id="@($"{Id}-syntax")" class="mt-2 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800">
            @switch (analysis)
            {
                case JsonAnalysis.Invalid { Position: { } position }:
                    <p data-testid="syntax-summary"><strong class="font-semibold">Not valid JSON</strong> at line @position.Line, column @position.Column.</p>
                    <pre class="mt-1 overflow-x-auto font-mono text-xs leading-5 text-red-900">@Excerpt(position)</pre>
                    <p class="mt-1 text-xs">Check for a missing comma or quote just before this point.</p>
                    break;
                case JsonAnalysis.Invalid:
                    <p data-testid="syntax-summary"><strong class="font-semibold">Not valid JSON:</strong> a \u escape in it stands for half a character and needs its pair.</p>
                    break;
                default:
                    <p data-testid="syntax-summary">@FlagFields.TooDeep</p>
                    break;
            }
        </div>
    }

    <FieldError Id="@($"{Id}-error")" Message="@error" />
</div>

@code {
    private ElementReference _area;

    /// <summary>O id do textarea; os textos ligados a ele usam o mesmo prefixo (<c>{Id}-size</c>, <c>{Id}-error</c>...).</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    /// <summary><see cref="FieldErrors.OnValue"/> ou <see cref="FieldErrors.OffValue"/>: dá o nome do valor no aviso falado.</summary>
    [Parameter, EditorRequired]
    public string Field { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Audience { get; set; } = string.Empty;

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> TextChanged { get; set; }

    /// <summary>O erro de quem salvou (o console ou a API); quando o texto nem é JSON, o erro de sintaxe vale por ele.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Ações a mais no cabeçalho, antes do Format.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    public ValueTask FocusAsync() => _area.FocusAsync();

    private Task ChangeAsync(ChangeEventArgs change) => TextChanged.InvokeAsync(change.Value as string ?? string.Empty);

    private Task FormatAsync() =>
        JsonText.Analyze(Text) is JsonAnalysis.Valid valid ? TextChanged.InvokeAsync(valid.Value.Indented()) : Task.CompletedTask;

    private string DescribedBy(bool showsSyntax, bool hasError)
    {
        var ids = new List<string> { $"{Id}-audience", $"{Id}-size" };
        if (showsSyntax)
        {
            ids.Add($"{Id}-syntax");
        }

        if (hasError)
        {
            ids.Add($"{Id}-error");
        }

        return string.Join(' ', ids);
    }

    private string LiveText(JsonAnalysis analysis) => analysis switch
    {
        JsonAnalysis.Valid { Level: MeterLevel.NearLimit } => FlagFields.NearLimit(Field),
        JsonAnalysis.Valid { Level: MeterLevel.OverLimit } => FlagFields.OverLimit(Field),
        JsonAnalysis.Invalid or JsonAnalysis.TooDeep => FlagFields.NotJson(Field),
        _ => string.Empty,
    };

    // A linha com o número e um ^ sob a coluna, como um compilador mostraria.
    private static string Excerpt(SyntaxPosition position)
    {
        var number = position.Line.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return $"{number} │ {position.LineText}\n{new string(' ', number.Length)} │ {position.Caret}";
    }

    private static (string Bar, string Text) MeterStyle(MeterLevel level) => level switch
    {
        MeterLevel.OverLimit => ("bg-red-600", "text-red-700"),
        MeterLevel.NearLimit => ("bg-amber-500", "text-amber-800"),
        _ => ("bg-slate-400", "text-slate-500"),
    };

    private static string MeterWidth(int bytes)
    {
        const int Full = 100;
        var percent = Math.Min(Full, bytes * Full / JsonText.MaxValueBytes);
        return percent.ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private static string Bytes(int count) => count == 1 ? "1 byte" : $"{Thousands(count)} bytes";

    private static string Thousands(int count) => count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
}
