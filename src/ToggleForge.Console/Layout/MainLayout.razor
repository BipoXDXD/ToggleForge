@* Layout das páginas que exigem sessão: confere com a API quem está logado antes de desenhar a página. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject ConsoleApi Api
@inject NavigationManager Navigation

@if (Session.Current is { } current)
{
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3 sm:px-6">
            <a href="" class="text-base font-semibold tracking-tight text-slate-900">ToggleForge</a>
            <div class="flex min-w-0 items-center gap-4 text-sm text-slate-600">
                <span class="min-w-0 wrap-anywhere" data-testid="member-email">@current.Member.Email</span>
                <button type="button" class="shrink-0 font-medium text-slate-700 hover:text-slate-900" @onclick="SignOutAsync">Sign out</button>
            </div>
        </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
        @Body
    </main>
}
else if (_problem is not null)
{
    <main class="mx-auto max-w-md px-6 py-24">
        <ProblemMessage Problem="_problem" />
    </main>
}
else
{
    @* Sem h1: o FocusOnNavigate focaria este título, e o foco se perderia quando a página o substituísse. *@
    <main class="boot-screen">
        <p role="status">Loading ToggleForge…</p>
    </main>
}

@code {
    private readonly CancellationTokenSource _leaving = new();
    private Problem? _problem;

    protected override async Task OnInitializedAsync()
    {
        Session.Ended += GoToSignIn;
        if (Session.Current is not null)
        {
            return;
        }

        var session = await Api.GetSessionAsync(_leaving.Token);
        if (session.Succeeded)
        {
            Session.Start(session.Value);
        }
        else if (session.Problem.StatusCode != System.Net.HttpStatusCode.Unauthorized)
        {
            _problem = session.Problem;
        }
    }

    private async Task SignOutAsync()
    {
        await Api.SignOutAsync(_leaving.Token);
        Session.End();
    }

    private void GoToSignIn() =>
        Navigation.NavigateTo(SignInRedirect.SignInPathFor(Navigation.ToBaseRelativePath(Navigation.Uri)));

    public void Dispose()
    {
        Session.Ended -= GoToSignIn;
        _leaving.Cancel();
        _leaving.Dispose();
    }
}
