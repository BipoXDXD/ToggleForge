@page "/organizations/{OrganizationId:guid}/projects/{ProjectKey}/environments/{EnvironmentKey}/flags/{FlagKey}"
@inherits ConsolePage
@inject ConsoleApi Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@FlagKey · @ProjectKey · ToggleForge</PageTitle>

<nav class="text-sm text-slate-500" aria-label="Breadcrumb">
    <a href="organizations/@OrganizationId/projects" class="hover:text-slate-700 hover:underline">Projects</a>
    <span aria-hidden="true"> / </span>
    <a href="@DraftPath" class="hover:text-slate-700 hover:underline">@ProjectKey · @EnvironmentKey</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page" class="font-mono text-slate-700">@FlagKey</span>
</nav>

<div class="mt-2 flex items-center gap-3">
    <h1 class="font-mono text-2xl font-semibold tracking-tight">@FlagKey</h1>
    @if (_flag is { } shown)
    {
        <FlagTypeBadge Type="@shown.Value.Type" />
    }
</div>
@if (_gone is not null)
{
    <p class="mt-6 text-sm text-slate-600">@_gone</p>
    <a href="@DraftPath" class="mt-4 inline-block text-sm font-medium text-indigo-700 hover:underline">Back to the draft</a>
}
else if (_loadProblem is not null)
{
    <div class="mt-6"><ProblemMessage Problem="_loadProblem" /></div>
}
else if (_flag is null || _edit is null)
{
    <p class="mt-6 text-sm text-slate-500">Loading the flag…</p>
}
else if (!CanEdit(_flag.Value))
{
    @if (!IsKnown(_flag.Value))
    {
        <p data-testid="unknown-type" class="mt-6 text-sm text-slate-600">This console cannot edit flags of type "@_flag.Value.Type" yet.</p>
    }
    @if (ShowsAsJson(_flag.Value))
    {
        <p class="mt-6 flex max-w-4xl gap-2 rounded-md border-l-2 border-amber-400 bg-amber-50 px-3 py-2 text-sm text-amber-900" id="json-public">
            <span aria-hidden="true">⚠</span>
            <span>Every player who has the game can read these values. Never put API keys, passwords or personal data in them.</span>
        </p>
    }
    <dl class="mt-6 grid max-w-4xl grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-sm">
        <dt class="text-slate-500">Type</dt>
        <dd><FlagTypeBadge Type="@_flag.Value.Type" /></dd>
        <dt class="text-slate-500">State</dt>
        <dd>@(_flag.Value.Enabled ? "Enabled" : "Disabled")</dd>
        <dt class="text-slate-500">Rollout</dt>
        <dd>@RolloutShare.Format(_flag.Value.RolloutBasisPoints)</dd>
        <dt class="text-slate-500">Value for included players</dt>
        <dd class="min-w-0">@ValueShown(_flag.Value, _flag.Value.OnValue)</dd>
        <dt class="text-slate-500">Value for everyone else</dt>
        <dd class="min-w-0">@ValueShown(_flag.Value, _flag.Value.OffValue)</dd>
    </dl>
}
else
{
    @if (_flag.Value.IsJson)
    {
        <p data-testid="type-fixed" class="mt-1 text-sm text-slate-600">The type is fixed: games already read this flag as JSON.</p>
    }
    <form class="@(_flag.Value.IsJson ? "max-w-4xl" : "max-w-lg") mt-6 space-y-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        @* Enquanto o pedido não volta, nada muda: o que se digitasse agora seria apagado pelos valores salvos. *@
        <fieldset disabled="@_busy" class="min-w-0 space-y-4">
            <label class="flex items-center gap-2">
                <input type="checkbox" @bind="_edit.Enabled" class="h-4 w-4" />
                <span class="text-sm text-slate-700">Enabled</span>
            </label>
            <div>
                <label for="rollout" class="block text-sm font-medium text-slate-700">Rollout (%)</label>
                <input id="rollout" @ref="_rollout" type="number" required min="0" max="100" step="0.01" @bind="_edit.RolloutPercent"
                       aria-invalid="@(RolloutError is null ? null : "true")" aria-describedby="@(RolloutError is null ? null : "rollout-error")"
                       class="tf-field w-40" />
                <FieldError Id="rollout-error" Message="@RolloutError" />
            </div>
            @if (_flag.Value.IsJson)
            {
                <div class="pt-4">
                    <JsonValuesInput @ref="_values"
                                     @bind-OnValueText="_edit.OnValueText" @bind-OnValueText:after="() => _form.Clear(FieldErrors.OnValue)"
                                     @bind-OffValueText="_edit.OffValueText" @bind-OffValueText:after="() => _form.Clear(FieldErrors.OffValue)"
                                     RolloutPercent="_edit.RolloutPercent" Enabled="_edit.Enabled" Errors="_form.Fields" TooLarge="_form.ValuesTooLarge" />
                </div>
            }
            else
            {
                <div>
                    <label class="block">
                        <span class="text-sm font-medium text-slate-700">Value for included players</span>
                        <select @ref="_includedChoice" @bind="_edit.OnValueText"
                                aria-invalid="@(OnValueError is null ? null : "true")" aria-describedby="@(OnValueError is null ? null : "on-value-error")"
                                class="tf-field w-40">
                            <option value="true">true</option>
                            <option value="false">false</option>
                        </select>
                    </label>
                    <FieldError Id="on-value-error" Message="@OnValueError" />
                </div>
                <div>
                    <label class="block">
                        <span class="text-sm font-medium text-slate-700">Value for everyone else</span>
                        <select @ref="_othersChoice" @bind="_edit.OffValueText"
                                aria-invalid="@(OffValueError is null ? null : "true")" aria-describedby="@(OffValueError is null ? null : "off-value-error")"
                                class="tf-field w-40">
                            <option value="true">true</option>
                            <option value="false">false</option>
                        </select>
                    </label>
                    <FieldError Id="off-value-error" Message="@OffValueError" />
                </div>
            }
        </fieldset>

        <ProblemMessage Problem="_form.Problem" Heading="@_form.Heading" />
        @if (_saved)
        {
            <p role="status" class="text-sm text-emerald-700">Saved to the draft. Games get it with the next publication.</p>
        }

        <div class="flex items-center gap-3">
            <button type="submit" @ref="_save" disabled="@_busy"
                    class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-60">
                Save
            </button>
            <button type="button" disabled="@_busy" @onclick="() => _confirmingRemoval = true"
                    class="rounded-md px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50 disabled:opacity-60">
                Remove from draft
            </button>
        </div>
    </form>

    @if (_confirmingRemoval)
    {
        <section role="alertdialog" aria-labelledby="remove-title" class="mt-6 max-w-lg rounded-md border border-red-200 bg-red-50 px-4 py-3">
            <h2 id="remove-title" class="text-sm font-semibold text-red-800">Remove @FlagKey from the draft?</h2>
            <p class="mt-1 text-sm text-red-800">Games keep receiving it until the next publication. Creating the key again later gives it a new rollout.</p>
            <div class="mt-3 flex gap-3">
                <button type="button" disabled="@_busy" @onclick="RemoveAsync"
                        class="rounded-md bg-red-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-600 disabled:opacity-60">
                    Remove
                </button>
                <button type="button" @onclick="() => _confirmingRemoval = false"
                        class="rounded-md px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100">
                    Keep it
                </button>
            </div>
        </section>
    }
}

@code {
    // Alvo de foco que não é campo: o botão Save, onde o membro estava quando salvou.
    private const string SaveButton = "save";

    private static readonly Problem _nothingToSave = new(
        "/problems/nothing-to-save", "Nothing to save", 400, "Nothing to save: these are already the values in the draft.");

    private static readonly Problem _changedMeanwhile = new(
        "/problems/flag-changed", "The flag changed", 412,
        "Someone changed this flag after you opened it. These are its current values; make your change again.");

    private Versioned<Flag>? _flag;
    private FlagEdit? _edit;
    private Problem? _loadProblem;
    private FlagFormState _form = new();
    private string? _gone;
    private bool _saved;
    private bool _busy;
    private bool _confirmingRemoval;
    private ElementReference _rollout;
    private JsonValuesInput? _values;
    private ElementReference _includedChoice;
    private ElementReference _othersChoice;
    private ElementReference _save;

    // Um campo (pelo ponteiro de FieldErrors) ou o SaveButton; nulo quando o foco fica onde está.
    private string? _focusAfterRender;

    [Parameter]
    public Guid OrganizationId { get; set; }

    [Parameter]
    public string ProjectKey { get; set; } = string.Empty;

    [Parameter]
    public string EnvironmentKey { get; set; } = string.Empty;

    [Parameter]
    public string FlagKey { get; set; } = string.Empty;

    private FlagAddress Address => new(OrganizationId, ProjectKey, EnvironmentKey, FlagKey);

    private string DraftPath =>
        $"organizations/{OrganizationId}/projects/{Uri.EscapeDataString(ProjectKey)}/environments/{Uri.EscapeDataString(EnvironmentKey)}";

    private string? RolloutError => _form.Fields.For(FieldErrors.Rollout);

    private string? OnValueError => _form.Fields.For(FieldErrors.OnValue);

    private string? OffValueError => _form.Fields.For(FieldErrors.OffValue);

    protected override async Task OnParametersSetAsync()
    {
        (_flag, _edit, _loadProblem, _gone, _saved, _form) = (null, null, null, null, false, new FlagFormState());
        var flag = await Api.GetFlagAsync(Address, Leaving);
        if (flag.Succeeded)
        {
            Show(flag.Value);
        }
        else if (flag.Problem.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _gone = "This flag is not in the draft.";
        }
        else
        {
            _loadProblem = flag.Problem;
        }
    }

    private async Task SaveAsync()
    {
        _saved = false;
        _form.Reset();
        if (_flag is not { } flag || _edit is not { } edit)
        {
            return;
        }

        if (!edit.TryGetChanges(flag.Value, out var changes, out var errors))
        {
            MarkFields(errors);
            return;
        }

        if (changes.IsEmpty)
        {
            _form.Show(_nothingToSave);
            return;
        }

        _busy = true;
        var saved = await Api.UpdateFlagAsync(Address, flag.ETag, changes, Leaving);
        _busy = false;
        if (saved.Succeeded)
        {
            Show(saved.Value);
            (_saved, _focusAfterRender) = (true, SaveButton);
            return;
        }

        await ExplainAsync(saved.Problem);
        if (_gone is null)
        {
            _focusAfterRender ??= SaveButton;
        }
    }

    // Durante o envio, o formulário travado tira o foco de onde ele estava e o navegador o manda para o <body>. O foco
    // volta depois do render que destrava o formulário e marca os erros, para o leitor de tela anunciar o campo já
    // inválido: no campo a corrigir ou, sem campo, no Save (WCAG 2.4.3).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRender is not { } target)
        {
            return;
        }

        _focusAfterRender = null;
        await (target switch
        {
            SaveButton => _save.FocusAsync(),
            FieldErrors.Rollout => _rollout.FocusAsync(),
            FieldErrors.OnValue when _values is null => _includedChoice.FocusAsync(),
            FieldErrors.OffValue when _values is null => _othersChoice.FocusAsync(),
            _ => _values?.FocusAsync(target) ?? ValueTask.CompletedTask,
        });
    }

    private async Task RemoveAsync()
    {
        if (_flag is not { } flag)
        {
            return;
        }

        _form.ClearSummary();
        _busy = true;
        var problem = await Api.DeleteFlagAsync(Address, flag.ETag, Leaving);
        _busy = false;
        _confirmingRemoval = false;
        if (problem is null)
        {
            Navigation.NavigateTo(DraftPath);
            return;
        }

        await ExplainAsync(problem);
    }

    /// <summary>
    /// 412: alguém mudou a flag depois da leitura, e nada foi gravado. Os valores atuais substituem o formulário,
    /// para o membro decidir de novo sobre eles, em vez de sobrescrever a mudança do outro às cegas.
    /// 400, 409 e 413: nada foi gravado, e o texto digitado fica no formulário para o membro corrigir.
    /// </summary>
    private async Task ExplainAsync(Problem problem)
    {
        switch (problem.StatusCode)
        {
            case System.Net.HttpStatusCode.PreconditionFailed:
                var current = await Api.GetFlagAsync(Address, Leaving);
                if (current.Succeeded)
                {
                    Show(current.Value);
                    _form.Show(_changedMeanwhile);
                }
                else
                {
                    _form.Show(current.Problem);
                }

                break;
            case System.Net.HttpStatusCode.NotFound:
                _gone = "This flag left the draft after you opened it.";
                break;
            case System.Net.HttpStatusCode.BadRequest:
                var (fields, general) = FieldErrors.Split(problem);
                MarkFields(fields, general);
                break;
            case System.Net.HttpStatusCode.Conflict when problem.Type == FormProblems.JsonBudgetReachedType:
                _form.Show(FormProblems.OutOfJsonRoom);
                break;
            case System.Net.HttpStatusCode.RequestEntityTooLarge when _flag?.Value.IsJson == true:
                _form.MarkValuesTooLarge();
                break;
            default:
                _form.Show(problem);
                break;
        }
    }

    // O foco vai para o primeiro campo a corrigir, depois do render que o marca (design spec, 3).
    private void MarkFields(FieldErrors fields, Problem? general = null)
    {
        _form.Mark(fields, general);
        _focusAfterRender = _form.FirstMarkedField;
    }

    private void Show(Versioned<Flag> flag)
    {
        _flag = flag;
        _edit = FlagEdit.Of(flag.Value);
    }

    private bool CanEdit(Flag flag) => IsKnown(flag) && Session.MembershipIn(OrganizationId) is { CanEditDrafts: true };

    // Um tipo novo da API pode ter regras que este console não conhece: ele mostra, mas não grava (design spec, 2.2).
    private static bool IsKnown(Flag flag) => flag.IsJson || flag.Type == FlagTypes.Boolean;

    // Na leitura, todo tipo que não é booleano aparece como bloco JSON e com o aviso de valor público: o valor de um tipo
    // que o console não conhece pode ser qualquer JSON, e o bloco mostra qualquer um (design spec, 2.2).
    private static bool ShowsAsJson(Flag flag) => flag.Type != FlagTypes.Boolean;

    private static RenderFragment ValueShown(Flag flag, FlagValue value) =>
        ShowsAsJson(flag) ? @<JsonValueBlock Value="value" Open="true" /> : @<span class="font-mono">@value.Text</span>;
}
