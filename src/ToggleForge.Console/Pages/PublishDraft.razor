@page "/organizations/{OrganizationId:guid}/projects/{ProjectKey}/environments/{EnvironmentKey}/publish"
@inherits ConsolePage
@inject ConsoleApi Api
@inject SessionState Session

<PageTitle>Publish · @ProjectKey · @EnvironmentKey · ToggleForge</PageTitle>

<nav class="text-sm text-slate-500" aria-label="Breadcrumb">
    <a href="organizations/@OrganizationId/projects" class="hover:text-slate-700 hover:underline">Projects</a>
    <span aria-hidden="true"> / </span>
    <a href="@DraftPath" class="hover:text-slate-700 hover:underline">@ProjectKey · @EnvironmentKey</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page" class="text-slate-700">Publish</span>
</nav>

<h1 class="mt-2 text-2xl font-semibold tracking-tight">Publish to @EnvironmentText.Title(_environment, EnvironmentKey)</h1>

@if (_loadProblem is not null)
{
    <div class="mt-6"><ProblemMessage Problem="_loadProblem" /></div>
}
else if (_environment is null || _draft is null)
{
    <p class="mt-6 text-sm text-slate-500">Loading the draft…</p>
}
else
{
    @if (_published is not null)
    {
        <div role="status" class="mt-6 max-w-lg rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            Version @_published.Version is live in @_environment.Name. Games pick it up on their next sync.
        </div>
        <a href="@DraftPath" class="mt-4 inline-block text-sm font-medium text-indigo-700 hover:underline">Back to the draft</a>
    }
    else if (Session.MembershipIn(OrganizationId) is not { CanEditDrafts: true })
    {
        <p class="mt-6 text-sm text-slate-600">Only owners and editors publish.</p>
    }
    else if (_draft.Changes.Count == 0)
    {
        <p class="mt-6 text-sm text-slate-600">Nothing to publish: the draft equals the current publication.</p>
        <a href="@DraftPath" class="mt-4 inline-block text-sm font-medium text-indigo-700 hover:underline">Back to the draft</a>
    }
    else
    {
        <section class="mt-6 max-w-lg" aria-labelledby="changes">
            <h2 id="changes" class="text-sm font-semibold text-slate-700">
                @(_draft.BasedOnVersion is { } current ? $"Changes since version {current}" : "First publication of this environment")
            </h2>
            <ul class="mt-2 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white text-sm" aria-label="Changes">
                @foreach (var change in _draft.Changes)
                {
                    <li class="flex justify-between px-4 py-2">
                        <span class="flex items-center gap-2">
                            <span class="font-mono">@change.FlagKey</span>
                            @if (TypeOf(change) is { } type)
                            {
                                <FlagTypeBadge Type="@type" />
                            }
                        </span>
                        <span class="text-slate-500">@change.Change</span>
                    </li>
                }
            </ul>
        </section>

        <form class="mt-6 max-w-lg space-y-4" @onsubmit="PublishAsync" @onsubmit:preventDefault>
            <label class="block">
                <span class="text-sm font-medium text-slate-700">Summary (optional)</span>
                <input maxlength="280" @bind="_summary" disabled="@(_attempt is not null)"
                       class="mt-1 block w-full rounded-md border border-slate-500 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none disabled:bg-slate-100" />
            </label>
            <label class="block">
                <span class="text-sm font-medium text-slate-700">Type @EnvironmentKey to confirm</span>
                <input autocomplete="off" spellcheck="false" @bind="_confirmation" @bind:event="oninput"
                       class="mt-1 block w-40 rounded-md border border-slate-500 px-3 py-2 font-mono text-sm focus:border-indigo-500 focus:outline-none" />
            </label>

            <ProblemMessage Problem="_problem" />

            @if (_attempt is null)
            {
                <button type="submit" disabled="@(_busy || !Confirmed)"
                        class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-60">
                    Publish @ChangeCount to @EnvironmentKey
                </button>
            }
            else
            {
                <button type="submit" disabled="@_busy"
                        class="rounded-md bg-amber-700 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-800 disabled:opacity-60">
                    Check the result
                </button>
            }
        </form>
    }
}

@code {
    private static readonly Problem _unknownResult = new(
        "/problems/unknown-result", "Unknown result", 0,
        "We could not confirm whether the publication happened. Check the result before doing anything else: checking never publishes twice.");

    private static readonly Problem _draftChanged = new(
        "/problems/draft-changed", "The draft changed", 409,
        "The draft changed while you reviewed it. These are its changes now; review them and publish again.");

    private ProjectEnvironment? _environment;
    private Draft? _draft;
    private Publication? _published;
    private Problem? _loadProblem;
    private Problem? _problem;
    private string _summary = string.Empty;
    private string _confirmation = string.Empty;
    private bool _busy;

    // Só existe enquanto o resultado é desconhecido: o reenvio usa o mesmo pedido e a mesma chave.
    private PublicationAttempt? _attempt;

    [Parameter]
    public Guid OrganizationId { get; set; }

    [Parameter]
    public string ProjectKey { get; set; } = string.Empty;

    [Parameter]
    public string EnvironmentKey { get; set; } = string.Empty;

    private EnvironmentAddress Address => new(OrganizationId, ProjectKey, EnvironmentKey);

    private bool Confirmed => string.Equals(_confirmation, EnvironmentKey, StringComparison.Ordinal);

    // Uma flag removida não está mais no rascunho, e o tipo dela só viria da publicação base; fica sem selo.
    private string? TypeOf(DraftChange change) => _draft?.Flags.FirstOrDefault(flag => flag.Key == change.FlagKey)?.Type;

    private string ChangeCount => _draft?.Changes.Count == 1 ? "1 change" : $"{_draft?.Changes.Count} changes";

    private string DraftPath =>
        $"organizations/{OrganizationId}/projects/{Uri.EscapeDataString(ProjectKey)}/environments/{Uri.EscapeDataString(EnvironmentKey)}";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var project = Api.GetProjectAsync(OrganizationId, ProjectKey, Leaving);
        var draft = Api.GetDraftAsync(OrganizationId, ProjectKey, EnvironmentKey, Leaving);
        var (loadedProject, loadedDraft) = (await project, await draft);
        if (!loadedProject.Succeeded)
        {
            _loadProblem = loadedProject.Problem;
        }
        else if (!loadedDraft.Succeeded)
        {
            _loadProblem = loadedDraft.Problem;
        }
        else if (loadedProject.Value.Environments.FirstOrDefault(environment => environment.Key == EnvironmentKey) is not { } environment)
        {
            _loadProblem = new Problem("/problems/not-found", "Not found", 404, "This environment does not exist in the project.");
        }
        else
        {
            (_environment, _draft) = (environment, loadedDraft.Value);
        }
    }

    private async Task PublishAsync()
    {
        if (_draft is null || (_attempt is null && !Confirmed))
        {
            return;
        }

        var attempt = _attempt ?? PublicationAttempt.Of(_draft.Revision, _summary);
        _problem = null;
        _busy = true;
        var publication = await Api.PublishAsync(Address, attempt.Request, attempt.IdempotencyKey, Leaving);
        _busy = false;
        if (publication.Succeeded)
        {
            (_published, _attempt) = (publication.Value, null);
            return;
        }

        switch (PublicationAttempt.Classify(publication.Problem))
        {
            case PublicationOutcome.Unknown:
                (_attempt, _problem) = (attempt, _unknownResult);
                break;
            case PublicationOutcome.DraftChanged:
                (_attempt, _confirmation) = (null, string.Empty);
                await LoadAsync();
                _problem = _draftChanged;
                break;
            case PublicationOutcome.NothingToPublish:
                _attempt = null;
                await LoadAsync();
                break;
            default:
                (_attempt, _problem) = (null, publication.Problem);
                break;
        }
    }
}
