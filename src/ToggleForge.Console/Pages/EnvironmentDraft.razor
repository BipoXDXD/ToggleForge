@page "/organizations/{OrganizationId:guid}/projects/{ProjectKey}/environments/{EnvironmentKey}"
@inherits ConsolePage
@inject ConsoleApi Api
@inject SessionState Session

<PageTitle>@ProjectKey · @EnvironmentKey · ToggleForge</PageTitle>

<nav class="text-sm text-slate-500" aria-label="Breadcrumb">
    <a href="organizations/@OrganizationId/projects" class="hover:text-slate-700 hover:underline">Projects</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page" class="text-slate-700">@(_project?.Name ?? ProjectKey)</span>
</nav>

@* Fora do carregamento: o FocusOnNavigate só acha o h1 que existe no primeiro render. *@
<h1 class="mt-2 text-2xl font-semibold tracking-tight">@(_project?.Name ?? ProjectKey)</h1>

@if (_loadProblem is not null)
{
    <div class="mt-6"><ProblemMessage Problem="_loadProblem" /></div>
}
else if (_project is null || _draft is null)
{
    <p class="mt-6 text-sm text-slate-500">Loading the draft…</p>
}
else
{
    @* Links entre páginas, não abas: Tab percorre, Enter troca de página, e o atual é a página corrente. *@
    <nav class="mt-6 flex gap-2 border-b border-slate-200" aria-label="Environments">
        @foreach (var environment in _project.Environments)
        {
            var current = environment.Key == EnvironmentKey;
            <a href="@EnvironmentPath(environment.Key)" aria-current="@(current ? "page" : null)"
               class="@(current ? "border-indigo-600 text-indigo-700" : "border-transparent text-slate-500 hover:text-slate-700") -mb-px border-b-2 px-3 py-2 text-sm font-medium">
                @environment.Name
            </a>
        }
    </nav>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm">
        <span class="text-slate-600" data-testid="draft-status">
            @(_draft.BasedOnVersion is { } live ? $"Version {live} is live." : "Never published.")
            @(_draft.Changes.Count switch { 0 => "No unpublished changes.", 1 => "1 unpublished change.", var count => $"{count} unpublished changes." })
        </span>
        <span class="flex items-center gap-3">
            <a href="@($"{EnvironmentPath(EnvironmentKey)}/simulator")" class="font-medium text-indigo-700 hover:underline">Simulate</a>
            @if (_draft.BasedOnVersion is not null)
            {
                <a href="@($"{EnvironmentPath(EnvironmentKey)}/history")" class="font-medium text-indigo-700 hover:underline">History</a>
            }
            @if (_draft.Changes.Count > 0 && Session.MembershipIn(OrganizationId) is { CanEditDrafts: true })
            {
                <a href="@($"{EnvironmentPath(EnvironmentKey)}/publish")"
                   class="rounded-md bg-indigo-600 px-3 py-1.5 font-semibold text-white hover:bg-indigo-500">Review and publish</a>
            }
        </span>
    </div>

    <section class="mt-6" aria-labelledby="draft-flags">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="draft-flags" class="text-lg font-semibold">Draft flags</h2>
            @if (_draft.Flags.Any(flag => flag.IsJson))
            {
                var jsonBytes = JsonBudget.BytesOf(_draft.Flags);
                var nearLimit = JsonBudget.IsNearLimit(jsonBytes);
                <p data-testid="json-budget" class="@(nearLimit ? "text-amber-800" : "text-slate-500") text-xs tabular-nums">
                    @if (nearLimit)
                    {
                        <span aria-hidden="true">⚠ </span>
                    }
                    JSON values: @JsonBudget.FormatKibibytes(jsonBytes) of @JsonBudget.MaxKibibytes KiB@(nearLimit ? $". Near the {JsonBudget.MaxKibibytes} KiB limit." : "")
                </p>
            }
        </div>
        @if (_draft.Flags.Count == 0)
        {
            <p class="mt-3 text-sm text-slate-600">No flags in this draft yet.</p>
        }
        else
        {
            <div class="mt-3 overflow-x-auto rounded-lg border border-slate-200 bg-white"
                 role="region" aria-labelledby="draft-flags" tabindex="0">
            <table class="w-full text-left text-sm" aria-labelledby="draft-flags">
                <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                        <th scope="col" class="px-4 py-2">Flag</th>
                        <th scope="col" class="px-4 py-2">State</th>
                        <th scope="col" class="px-4 py-2">Rollout</th>
                        <th scope="col" class="px-4 py-2">Values</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var flag in _draft.Flags)
                    {
                        <tr class="align-top">
                            <td class="px-4 py-2">
                                <span class="flex flex-wrap items-center gap-2">
                                    <a href="@FlagPath(flag.Key)" data-testid="flag-key" class="font-mono text-indigo-700 hover:underline">@flag.Key</a>
                                    <FlagTypeBadge Type="@flag.Type" />
                                </span>
                            </td>
                            <td class="px-4 py-2">@(flag.Enabled ? "Enabled" : "Disabled")</td>
                            <td class="px-4 py-2">@RolloutShare.Format(flag.RolloutBasisPoints)</td>
                            <td class="px-4 py-2"><ValuePair OnValue="flag.OnValue" OffValue="flag.OffValue" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </section>

    @if (Session.MembershipIn(OrganizationId) is { CanEditDrafts: true })
    {
        <section class="mt-10 max-w-lg" aria-labelledby="new-flag">
            <h2 id="new-flag" class="text-lg font-semibold">New flag</h2>
            <form class="mt-4 space-y-4" @onsubmit="CreateFlagAsync" @onsubmit:preventDefault>
                <label class="block">
                    <span class="text-sm font-medium text-slate-700">Key</span>
                    <input required maxlength="64" @bind="_flagKey"
                           class="tf-field w-full font-mono" />
                </label>
                <label class="block">
                    <span class="text-sm font-medium text-slate-700">Rollout (%)</span>
                    <input type="number" required min="0" max="100" step="0.01" @bind="_rolloutPercent"
                           class="tf-field w-40" />
                </label>
                <label class="flex items-center gap-2">
                    <input type="checkbox" @bind="_enabled" class="h-4 w-4" />
                    <span class="text-sm text-slate-700">Enabled</span>
                </label>
                <ProblemMessage Problem="_createProblem" />
                <button type="submit" disabled="@_submitting"
                        class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-60">
                    Add to draft
                </button>
            </form>
        </section>
    }
}

@code {
    private static readonly Problem _invalidRollout = new(
        "/problems/invalid-rollout", "Invalid rollout", 400, "Enter a rollout between 0 and 100, with at most two decimals.");

    private Project? _project;
    private Draft? _draft;
    private Problem? _loadProblem;
    private Problem? _createProblem;
    private string _flagKey = string.Empty;
    private decimal _rolloutPercent;
    private bool _enabled = true;
    private bool _submitting;

    [Parameter]
    public Guid OrganizationId { get; set; }

    [Parameter]
    public string ProjectKey { get; set; } = string.Empty;

    [Parameter]
    public string EnvironmentKey { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _project = null;
        _draft = null;
        _loadProblem = null;
        var project = Api.GetProjectAsync(OrganizationId, ProjectKey, Leaving);
        var draft = Api.GetDraftAsync(OrganizationId, ProjectKey, EnvironmentKey, Leaving);
        var (loadedProject, loadedDraft) = (await project, await draft);
        if (!loadedProject.Succeeded)
        {
            _loadProblem = loadedProject.Problem;
        }
        else if (!loadedDraft.Succeeded)
        {
            _loadProblem = loadedDraft.Problem;
        }
        else
        {
            (_project, _draft) = (loadedProject.Value, loadedDraft.Value);
        }
    }

    private async Task CreateFlagAsync()
    {
        _createProblem = null;
        if (!RolloutShare.TryToBasisPoints(_rolloutPercent, out var basisPoints))
        {
            _createProblem = _invalidRollout;
            return;
        }

        _submitting = true;
        // O console do tracer bullet só cria flags booleanas comuns: incluído recebe true, excluído recebe false.
        var flag = await Api.CreateFlagAsync(
            OrganizationId, ProjectKey, EnvironmentKey, new FlagCreation(_flagKey, FlagTypes.Boolean, _enabled, OnValue: FlagValue.True, OffValue: FlagValue.False, basisPoints), Leaving);
        _submitting = false;
        if (!flag.Succeeded)
        {
            _createProblem = flag.Problem;
            return;
        }

        (_flagKey, _rolloutPercent, _enabled) = (string.Empty, 0, true);
        await ReloadDraftAsync();
    }

    /// <summary>A lista de mudanças vem da API: comparar com a publicação é regra dela, não do console.</summary>
    private async Task ReloadDraftAsync()
    {
        var draft = await Api.GetDraftAsync(OrganizationId, ProjectKey, EnvironmentKey, Leaving);
        if (draft.Succeeded)
        {
            _draft = draft.Value;
        }
        else
        {
            _loadProblem = draft.Problem;
        }
    }

    private string EnvironmentPath(string environmentKey) =>
        $"organizations/{OrganizationId}/projects/{Uri.EscapeDataString(ProjectKey)}/environments/{Uri.EscapeDataString(environmentKey)}";

    private string FlagPath(string flagKey) => $"{EnvironmentPath(EnvironmentKey)}/flags/{Uri.EscapeDataString(flagKey)}";
}
